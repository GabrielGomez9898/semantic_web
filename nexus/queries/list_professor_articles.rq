PREFIX nex: <https://w3id.org/nexus/ontology#>

SELECT ?professorName ?articleId ?year ?title ?url
WHERE {
  ?professor a nex:Professor ;
             nex:name ?professorName ;
             nex:hasArticle ?article .
  ?article nex:articleId ?articleId ;
           nex:title ?title .
  OPTIONAL { ?article nex:publicationYear ?year }
  OPTIONAL { ?article nex:url ?url }
  FILTER(CONTAINS(LCASE(STR(?professorName)), LCASE("Ruben")))
}
ORDER BY DESC(?year) ?title
