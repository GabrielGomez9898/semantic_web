    nex:articleId 67290 ;
    nex:classification "D" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/37028>,
        <https://w3id.org/nexus/resource/professor/43319>,
        <https://w3id.org/nexus/resource/professor/7910> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Developing a theory based on the causes of technical debt injection into software projects in Colombia" ;
    nex:url "http://doi.org/10.1088/1742-6596/1587/1/012022"^^xsd:anyURI .

<https://w3id.org/nexus/resource/article/67296> a nex:JournalArticle ;
    nex:articleId 67296 ;
    nex:classification "B" ;
    nex:description "Ultrasound images are used for a wide variety of medical purposes because of their capacity to study moving structures in real time. However, the quality of ultrasound images is signicantly affected by external factors limiting interpretability. We present UltraGAN, a novel method for ultrasound enhancement that transfers quality details while preserving structural information. UltraGAN incorporates frequency loss functions and an anatomical coherence constraint to perform quality enhancement. We show improvement in image quality without sacricing anatomical consistency. We validate UltraGAN on a publicly available dataset for echocardiography segmentation and demonstrate that our quality-enhanced images are able to improve downstream tasks. To ensure reproducibility we provide our source code and training models." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/10312>,
        <https://w3id.org/nexus/resource/professor/55865>,
        <https://w3id.org/nexus/resource/professor/7154> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "UltraGAN: Ultrasound Enhancement through Adversarial Generation" ;
    nex:url "https://doi.org/10.1007/978-3-030-60946-7_12"^^xsd:anyURI .

