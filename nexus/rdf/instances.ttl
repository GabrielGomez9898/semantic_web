<https://w3id.org/nexus/resource/article/75917> a nex:JournalArticle ;
    nex:articleId 75917 ;
    nex:classification "B" ;
    nex:description "Copyright © 2020 Magnolia Press.Isostenosmylus Krüger, 1913 is the richest genus of Osmylidae of the Neotropical region, with 17 described species so far, which are distributed mainly in the Andean region and in the South of Brazil and Paraguay. A new remarkable Colombian species of Isostenosmylus-I. ammirabilis sp. nov.-is herein described and illustrated. DNA barcode of mitochondrial gene cytochrome c oxidase subunit I (COI) for this species is also provided. Taxonomic keys for the genus are updated." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/7185> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Isostenosmylus ammirabilis sp. nov., a remarkable new species of lance lacewing (Neuroptera: Osmylidae) from the Colombian Andes" ;
    nex:url "http://doi.org/10.11646/zootaxa.4803.3.10"^^xsd:anyURI .

