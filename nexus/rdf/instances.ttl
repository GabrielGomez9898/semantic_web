<https://w3id.org/nexus/resource/article/80220> a nex:JournalArticle ;
    nex:articleId 80220 ;
    nex:classification "B" ;
    nex:description "Rheumatoid arthritis (RA) is a systemic autoimmune disease that increased bone resorption. Periodontal disease (PD) is an associated risk factor of RA. Studies suggest an association between bone markers such as the dickkopf-related protein 1 (DKK-1) and progression of radiological damage. We aimed to evaluate the marker DKK-1, its polymorphisms in patients with early rheumatoid arthritis (eRA), and its association with rheumatic, radiological, and periodontal variables." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/61884> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Association of Dickkopf-1 Polymorphisms With Radiological Damage and Periodontal Disease in Patients With Early Rheumatoid Arthritis: A Cross-Sectional Study" ;
    nex:url "http://doi.org/10.1097 / RHU.0000000000001391"^^xsd:anyURI .

