    nex:articleId 112027 ;
    nex:description "Traducción al francés de \"La concepción del Nuevo Mundo desde la crítica de la ley natural en Montaigne\"" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/7724> ;
    nex:productType "article" ;
    nex:publicationYear 2021 ;
    nex:title "La conception du Nouveau Monde d’après la critique de la loi naturelle chez Montaigne" ;
    nex:url "http://doi.org/10.48611/isbn.978-2-406-12607-2.p.0337"^^xsd:anyURI .

