        <https://w3id.org/nexus/resource/professor/9593> ;
    nex:productType "article" ;
    nex:publicationYear 2016 ;
    nex:title "Behavioral fever response in Rhodnius prolixus (Reduviidae: Triatominae) to intracoelomic inoculation of Trypanosoma cruzi" ;
    nex:url "http://doi.org/10.1590/0037-8682-0415-2015"^^xsd:anyURI .

