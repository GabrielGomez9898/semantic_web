<https://w3id.org/nexus/resource/article/95776> a nex:JournalArticle ;
    nex:articleId 95776 ;
    nex:classification "A" ;
    nex:description "Evidence has shown that sleep plays a key role in cognitive functioning, and here the specific importance for memory consolidation in the context of academic performance is discussed. As school years are also a turning point into defining one’s chronotype and general sleep habits, it is vital that schools and universities offer a flexible structure for students to be able to develop healthy sleep practices allowing for the very much needed space for memory consolidation." ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Sleep and academic performance: considering amount, quality and timing." ;
    nex:url "https://doi.org/10.1016/j.cobeha.2019.12.008"^^xsd:anyURI .

