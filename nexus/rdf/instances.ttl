<https://w3id.org/nexus/resource/article/129000> a nex:JournalArticle ;
    nex:articleId 129000 ;
    nex:description "El conflicto armado colombiano produjo diversas formas de violencia contra las mujeres. Frente a estas violencias, resulta importante observar la emergencia de sus estrategias de resistencia. El objetivo de este artículo es presentar los resultados de una investigación realizada con cinco organizaciones de mujeres víctimas del conflicto armado. Se aborda el protagonismo de sus integrantes en el desarrollo de estrategias de resistencia frente a su condición de víctimas, en un contexto de desplazamiento forzado y numerosas dificultades para reorganizar sus vidas." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/9834> ;
    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "Estrategias de resistencia de mujeres: conflicto armado colombiano, violencias de género y organizaciones de víctimas" ;
    nex:url "https://tramasyredes-ojs.clacso.org/ojs/index.php/tyr/article/view/415"^^xsd:anyURI .

