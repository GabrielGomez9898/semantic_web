<https://w3id.org/nexus/resource/article/135510> a nex:JournalArticle ;
    nex:articleId 135510 ;
    nex:description "Managing energy in microgrids with high renewable penetration is challenging due to variability and uncertainty in generation and demand. This paper presents a stochastic rolling horizon energy management system (EMS) for three-phase unbalanced microgrids. The approach integrates uncertainty into decision-making and uses a nonlinear current-based model with a quadratic constraint program (QCP) for efficiency. Simulations show a 0.52% reduction in expected operational costs compared to deterministic rolling horizon methods." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/26581>,
        <https://w3id.org/nexus/resource/professor/38787>,
        <https://w3id.org/nexus/resource/professor/76250> ;
    nex:productType "article" ;
    nex:publicationYear 2025 ;
    nex:title "A Stochastic Lookahead Approach to Energy Management in Three-Phase Unbalanced Microgrids" ;
    nex:url "https://ieeexplore.ieee.org/document/11259232"^^xsd:anyURI .

