<https://w3id.org/nexus/resource/article/130129> a nex:JournalArticle ;
    nex:articleId 130129 ;
    nex:classification "D" ;
    nex:description "This article lays out a comprehensive map of Fernando Pessoa’s dramatic production—which to date remains only partially published and studied—in order to determine the place that, once transcribed and edited, the unpublished play The Duke of Parma would occupy within the author’s dramatic corpus. The article proposes a classification of eight subgenres of Pessoa’s drama, both published and unpublished, and shows current statistics relating to the quantitative significance of Pessoa’s drama vis-à-vis the author’s archive and poetic production. Ultimately, this article ascertains the need to transcribe, edit, and publish The Duke of Parma in order to further comprehend the author’s dramatic and overall oeuvre." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/89250> ;
    nex:productType "article" ;
    nex:publicationYear 2025 ;
    nex:title "The Duke of Parma in Fernando Pessoa’s Dramatic Corpus: Preliminary Inventory, Classification, and Statistics" ;
    nex:url "https://muse.jhu.edu/pub/19/article/953819"^^xsd:anyURI .

