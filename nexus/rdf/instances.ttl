<https://w3id.org/nexus/resource/article/130546> a nex:JournalArticle ;
    nex:articleId 130546 ;
    nex:classification "B" ;
    nex:description "This work is aimed at reflecting on expert testimony, with special emphasis on the causes of canonical marriage annulment. The article identifies the procedural basis of expert testimony based on the Canon Law Code (1983), and Dignitas Connubi Instruction, a papal document that governs expert testimony in cases of marriage annulment being heard before Colombia's ecclesiastical courts. The article also studies the profile of the expert in the canon marriage process and how to intervene in canonical justice." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8799> ;
    nex:productType "article" ;
    nex:publicationYear 2015 ;
    nex:title "Expert testimony in the process of matrimonial nullity in canon law" ;
    nex:url "https://api.elsevier.com/content/abstract/scopus_id/84956697385"^^xsd:anyURI .

