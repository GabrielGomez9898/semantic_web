<https://w3id.org/nexus/resource/article/112751> a nex:JournalArticle ;
    nex:articleId 112751 ;
    nex:classification "A" ;
    nex:description "This paper presents current findings about the historical use of silver and metallic elements as part of the decorative technique from Colombia known as barniz de Pasto. The results are part of a broader ongoing research. The aim is to interpret and assess the introduction of metal as a significant component in the consolidation of the technique. Our research uses well-established imaging techniques (visible light macrophotography; infrared and ultraviolet photography), cross-sections, and elemental mapping from SEM-EDS. The results are compared and interpreted within a holistic framework suggesting the introduction of silver as part of an innovation of the barniz de Pasto technique, either as whole silver leaf sandwiched between layers of mopa mopa or as “venturine”, obtained by kneading, and therefore fragmenting, silver leaf within mopa mopa layers." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/7882>,
        <https://w3id.org/nexus/resource/professor/8216> ;
    nex:productType "article" ;
    nex:publicationYear 2023 ;
    nex:title "The splendour of glitter. Silver leaf in barniz de Pasto objects" ;
    nex:url "https://doi.org/ 10.3390/heritage6100344"^^xsd:anyURI .

