    nex:articleId 66774 ;
    nex:classification "A" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/30347> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "An exact optimization approach to the principal-agent problem in infrastructure projects via PPPs" ;
    nex:url "https://doi.org/10.1080/15623599.2020.1757572"^^xsd:anyURI .

