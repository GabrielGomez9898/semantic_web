    nex:articleId 48862 ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/50059> ;
    nex:productType "article" ;
    nex:publicationYear 2014 ;
    nex:title "A SysML based design pattern for the high-level development of mechatronic systems to enhance re-usability" ;
    nex:url "http://doi.org/10.3182/20140824-6-za-1003.00615"^^xsd:anyURI .

