<https://w3id.org/nexus/resource/article/117260> a nex:JournalArticle ;
    nex:articleId 117260 ;
    nex:classification "B" ;
    nex:description "We analyze correlation structures in financial markets by coarse graining the Pearson correlation matrices according to market sectors to obtain Guhr matrices using Guhr's correlation method according to P Rinn et al (2015, Europhysics Letters110, 68 003). We compare the results for the evolution of market states and the corresponding transition matrices with those obtained using Pearson correlation matrices. The behavior of market states is found to be similar for both the coarse grained and Pearson matrices. However, the number of relevant variables is reduced by orders of magnitude." ;
    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "Coarse graining correlation matrices according to macrostructures: Financial markets as a paradigm" ;
    nex:url "https://iopscience.iop.org/article/10.1088/1402-4896/ad5b97"^^xsd:anyURI .

