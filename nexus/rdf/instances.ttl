        <https://w3id.org/nexus/resource/professor/8666> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Enhancing sleep slow waves by auditory closed-loop stimulation using in-ear EEG sensors." .

<https://w3id.org/nexus/resource/article/73717> a nex:JournalArticle ;
    nex:articleId 73717 ;
    nex:classification "B" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/27265>,
        <https://w3id.org/nexus/resource/professor/50059>,
        <https://w3id.org/nexus/resource/professor/7003>,
