<https://w3id.org/nexus/resource/article/55558> a nex:JournalArticle ;
    nex:articleId 55558 ;
    nex:classification "C" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/10802> ;
    nex:productType "article" ;
