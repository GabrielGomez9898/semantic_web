<https://w3id.org/nexus/resource/article/71415> a nex:JournalArticle ;
    nex:articleId 71415 ;
    nex:classification "B" ;
    nex:description "In this essay we go “behind the scenes'' of the festival to reveal our rationale for film aesthetic in comparative education.  We emphasize three aspects related to the aesthetics of film: social, interactive, and integrative. These orient our approach to curating and organizing the film festival.  In the second part of this review we show how this approach translated into the organization of this year's festival during the vCIES conference Education Beyond the Human." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/43236> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Experiencing Education through Film: Behind the Scenes of the CIES Film Festivalette" ;
    nex:url "https://www.journals.uchicago.edu/doi/10.1086/710775"^^xsd:anyURI .

