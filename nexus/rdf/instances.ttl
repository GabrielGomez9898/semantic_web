<https://w3id.org/nexus/resource/article/133680> a nex:JournalArticle ;
    nex:articleId 133680 ;
    nex:classification "B" ;
    nex:description "Textile practices invite alternative socio-spatial relationships to those produced by hegemonic maps. Through the processes of wool transformation, from fleece to spinning and knitting, the continuous co-creation of human bodies as territory, and a territory as a body, is materialized. The research is based on a series of textile reflections between a group of urban women architects and designers from Bogotá and a group of rural textile master women from the municipality of Sutatausa, Colombia. This article presents three textile gestures that reflect tensions in representing territory." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/10444>,
        <https://w3id.org/nexus/resource/professor/88860> ;
    nex:productType "article" ;
    nex:publicationYear 2025 ;
    nex:title "Territory(ies)-Body(ies): Textiles and Embodied Experiences That Produce Maps" ;
    nex:url "https://www.tandfonline.com/doi/full/10.1080/14759756.2025.2524885"^^xsd:anyURI .

<https://w3id.org/nexus/resource/article/133718> a nex:JournalArticle ;
    nex:articleId 133718 ;
    nex:classification "A" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8738>,
