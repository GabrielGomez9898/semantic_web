<https://w3id.org/nexus/resource/article/87235> a nex:JournalArticle ;
    nex:articleId 87235 ;
    nex:classification "A" ;
    nex:description "Introducing systems thinking concepts in the programme evaluation field has been mostly aimed at supporting the practice of evaluation, rather than towards making theoretical advancements in the evaluation field. This paper introduces ideas and principles from systems thinking at the theoretical and practical levels in the programme evaluation field as applied to a peace-building programme called the Hermes Programme in Colombia. This document demonstrates how systems thinking concepts and tools were used in the practice of evaluation. We show the theoretical development of the proposed evaluation and explain how its stages were carried out in evaluating the Hermes Programme. This paper also illustrates the benefits of using systems thinking in evaluation." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/10726>,
        <https://w3id.org/nexus/resource/professor/9856> ;
    nex:productType "article" ;
    nex:publicationYear 2022 ;
    nex:title "Systems thinking concepts within a collaborative programme evaluation methodology: The Hermes Programme evaluation" ;
    nex:url "http://doi.org/10.1002/sres.2822"^^xsd:anyURI .

<https://w3id.org/nexus/resource/article/8726> a nex:JournalArticle ;
    nex:articleId 8726 ;
    nex:classification "C" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/7928>,
        <https://w3id.org/nexus/resource/professor/8543> ;
    nex:productType "article" ;
