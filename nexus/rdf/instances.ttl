    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8818> ;
    nex:productType "article" ;
    nex:publicationYear 2022 ;
    nex:title "Desdits «gouvernements progressistes»,«chaînes productives», humiliation et monde souterrain dans la Colombie extractive" .

