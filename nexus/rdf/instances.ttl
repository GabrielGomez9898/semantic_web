        <https://w3id.org/nexus/resource/professor/9867> ;
    nex:productType "article" ;
    nex:publicationYear 2019 ;
    nex:title "An asbestos contaminated town in the vicinity of an asbestos-cement facility: The case study of Sibaté, Colombia" ;
    nex:url "https://doi.org/10.1016/j.envres.2019.04.031"^^xsd:anyURI .

