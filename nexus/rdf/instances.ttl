<https://w3id.org/nexus/resource/article/140316> a nex:JournalArticle ;
    nex:articleId 140316 ;
    nex:description "El artículo presenta los resultados de una investigación colaborativa y participativa con mujeres indígenas Sikuani del Resguardo Wacoyo, en Colombia, centrada en el liderazgo femenino, la educación intercultural y el plurilingüismo. A través de los Círculos de la Palabra y la construcción colectiva de conocimientos, se reconocen los saberes ancestrales, las experiencias y la agencia de las mujeres en la transformación de sus comunidades. Los hallazgos destacan la importancia del diálogo interepistémico, la justicia epistémica y la construcción de un Tercer Espacio intercultural que cuestione las relaciones coloniales de poder y promueva prácticas educativas culturalmente situadas y transformadoras." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/9822> ;
    nex:productType "article" ;
    nex:publicationYear 2025 ;
    nex:title "Indigenous female leadership in a plurilingual context: Embracing participatory action in intercultural education" ;
    nex:url "https://doi.org/10.1080/14708477.2025.2528049"^^xsd:anyURI .

