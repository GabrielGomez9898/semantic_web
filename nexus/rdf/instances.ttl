    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8513> ;
    nex:productType "article" ;
    nex:publicationYear 2016 ;
    nex:title "Climate variability and human impact in South America during the last 2000 years: Synthesis and perspectives from pollen records" ;
    nex:url "http://doi.org/10.5194/cp-12-483-2016"^^xsd:anyURI .

