        <https://w3id.org/nexus/resource/professor/9868> ;
    nex:productType "article" ;
    nex:publicationYear 2023 ;
    nex:title "Burden of respiratory failure in pediatric patients: Analysis of a prospective multicenter cohort in Bogotá, Colombia" ;
    nex:url "http://doi.org/10.1002/hsr2.1617"^^xsd:anyURI .

