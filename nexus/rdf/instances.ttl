    nex:title "Cash and Ballots: Conditional Transfers, Political Participation and Voting Behavior" ;
    nex:url "https://doi.org/10.1086/701211"^^xsd:anyURI .

<https://w3id.org/nexus/resource/article/52284> a nex:JournalArticle ;
    nex:articleId 52284 ;
    nex:classification "B" ;
    nex:description "Ground states of quadratic Hamiltonians for fermionic systems can be characterized in terms of orthogonal complex structures. The standard way in which such Hamiltonians are diagonalized makes use of a certain \"doubling\" of the Hilbert space. In this work, we show that this redundancy in the Hilbert space can be completely lifted if the relevant orthogonal structure is taken into account. Such an approach allows for a treatment of Majorana fermions which is both physically and mathematically transparent. Furthermore, an explicit connection between orthogonal complex structures and the topological invariant is given." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/10103>,
        <https://w3id.org/nexus/resource/professor/39220> ;
    nex:productType "article" ;
    nex:publicationYear 2018 ;
    nex:title "Majorana fermions and orthogonal complex structures" ;
    nex:url "http://doi.org/10.1142/S0217732318400011"^^xsd:anyURI .

