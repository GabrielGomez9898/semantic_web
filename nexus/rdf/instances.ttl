<https://w3id.org/nexus/resource/article/7070> a nex:JournalArticle ;
    nex:articleId 7070 ;
    nex:classification "D" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8191>,
        <https://w3id.org/nexus/resource/professor/9890> ;
    nex:productType "article" ;
