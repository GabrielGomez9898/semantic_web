<https://w3id.org/nexus/resource/article/117375> a nex:JournalArticle ;
    nex:articleId 117375 ;
    nex:classification "B" ;
    nex:description "The work “Numerical investigation and circuit analysis of interdigitated photo-conductive antenna for therahertz applications” presents an equivalent circuit model for terahertz antennas with an interdigitated topology. In this work, the proposed model is used to enhance the antenna efficiency by optimizing the structural parameters of the interdigitated topology. However, several equations used in the model presents inconsistencies that directly affects the presented results of circuit model. In the present communication we discusses the inconsistencies in the proposed model assumptions and respectfully suggest possible corrections." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/11165>,
        <https://w3id.org/nexus/resource/professor/7240>,
        <https://w3id.org/nexus/resource/professor/7947> ;
    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "Numerical investigation and circuit analysis of interdigitated photoconductive antenna for terahertz applications" ;
    nex:url "https://link.springer.com/article/10.1007/s11082-023-05565-3"^^xsd:anyURI .

