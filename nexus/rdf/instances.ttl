<https://w3id.org/nexus/resource/article/115460> a nex:JournalArticle ;
    nex:articleId 115460 ;
    nex:classification "A" ;
    nex:description "This article analyses the structure and changes of large companies based on a new database of the 200 largest non-financial firms operating from 1913 to 1971 in Argentina. The main contribution of the research consists of the elaboration of the rankings of the 200 largest companies according to their paid-up capital between 1913 and 1971 and the construction of a database of large companies based on homogeneous sources and criteria. The study identifies the long-lasting presence of family-based diversified business groups and foreign multinationals from the first global period to the end of Import Substitution Industrialisation. It also shows that the presence of foreign companies among the 200 largest firms is higher than that identified in other countries. The study constitutes the first comprehensive research into big business in Argentina until the 1970s and a first attempt to identify the life cycles of the largest companies in Argentina." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/28824> ;
    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "The rise and transformation of big business in Argentina (1913–1971)" ;
    nex:url "https://www.cambridge.org/core/journals/revista-de-historia-economica-journal-of-iberian-and-latin-american-economic-history/article/abs/rise-and-transformation-of-big-business-in-argentina-19131971/4764FCCD8D274A0EB109FC7E3E8861CB"^^xsd:anyURI .

