<https://w3id.org/nexus/resource/article/63923> a nex:JournalArticle ;
    nex:articleId 63923 ;
    nex:classification "A" ;
    nex:description "A simple, inexpensive, step economic, and highly modular synthetic strategy to access izidine alkaloids is described. The key step is a TfOH-promoted intramolecular aldol condensation between enol and cyclic imide moieties. This cyclization strategy can be employed within an aza-Robinson annulation framework and represents a general tool to build fused bicyclic amines. To illustrate the power of this method, we describe the preparation of (±)-coniceine, (±)-quinolizidine, (±)-tashiromine, (±)-epilupinine, and the core of (±)-valmerins" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/37047>,
        <https://w3id.org/nexus/resource/professor/8299> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "Activating Imides with Triflic Acid: A General Intramolecular Aldol Condensation Strategy Toward Indolizidine, Quinolizidine, and Valmerin Alkaloids" ;
    nex:url "http://doi.org/10.1021/acs.orglett.9b04199"^^xsd:anyURI .

