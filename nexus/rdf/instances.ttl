    nex:publicationYear 2019 ;
    nex:title "Enhanced Gold Biosorption of Lysinibacillus sphaericus CBAM5 by Encapsulation of Bacteria in an Alginate Matrix" ;
    nex:url "http://doi.org/10.3390/met9080818"^^xsd:anyURI .

