    nex:publicationYear 2020 ;
    nex:title "Backtesting expected shortfall for world stock indexETFswith extreme value theory andGram-Charliermixtures" ;
    nex:url "http://doi.org/10.1002/ijfe.2009"^^xsd:anyURI .

