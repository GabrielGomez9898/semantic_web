    nex:productType "article" ;
    nex:publicationYear 2021 ;
    nex:title "Electrical Power Diversification: An Approach Based on the Method of Maximum Entropy in the Mean" ;
    nex:url "http://doi.org/10.3390/e23030281"^^xsd:anyURI .

<https://w3id.org/nexus/resource/article/8357> a nex:JournalArticle ;
    nex:articleId 8357 ;
    nex:classification "A" ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/9685>,
