    nex:title "Microwave-assisted synthesis, crystal structures, and photophysical properties of functionalized benzo[b]furans" ;
    nex:url "https://pubs.rsc.org/ra/article/16/43/53011/1298845/Microwave-assisted-synthesis-crystal-structures"^^xsd:anyURI .

