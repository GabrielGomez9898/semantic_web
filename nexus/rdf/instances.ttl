<https://w3id.org/nexus/resource/article/67548> a nex:JournalArticle ;
    nex:articleId 67548 ;
    nex:classification "B" ;
    nex:description "El texto ofrece una lectura crítica de la legislación de protección a la maternidad en Colombia y utiliza investigación cualitativa para mostrar los efectos de la falta de una regulación pre-contractual en materia laboral en el país. Argumento que  entre los efectos de la carencia de una regulación pre-contractual en materia laboral y por lo mismo una ausencia de sanción a la discriminación por sexo en el acceso al empleo, se mantiene materialmente una barrera de acceso al empleo para las mujeres difícil de sobrepasar." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/53707> ;
    nex:productType "article" ;
    nex:publicationYear 2019 ;
    nex:title "\"A mi me gustaría pero en mis condiciones no puedo\". Maternidad, Discriminación y Exclusión: el paso del trabajo formal al trabajo informal en confección en Colombia" ;
    nex:url "https://doi.org/10.18046/recs.iEspecial.3239"^^xsd:anyURI .

