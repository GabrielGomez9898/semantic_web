<https://w3id.org/nexus/resource/article/78615> a nex:JournalArticle ;
    nex:articleId 78615 ;
    nex:classification "C" ;
    nex:description "Según estimaciones mundiales de la OMS de 2017, el 9,6% de los niños menores de cinco años padecen retraso del crecimiento. La evidencia mundial muestra que estas acciones para la prevención y el retraso del crecimiento y la recuperación del crecimiento son relevantes si se abordan de manera intersectorial. Por lo tanto, es necesario identificar acciones intersectoriales para abordar el riesgo de retraso del crecimiento durante el embarazo y los dos primeros años de vida." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/34026> ;
    nex:productType "article" ;
    nex:publicationYear 2021 ;
    nex:title "Evidencia mundial sobre el retraso del crecimiento infantil desde una perspectiva de salud pública: una revisión sistemática" ;
    nex:url "http://doi.org/10.7705/biomedica.6017"^^xsd:anyURI .

