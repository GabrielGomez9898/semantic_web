<https://w3id.org/nexus/resource/article/42582> a nex:JournalArticle ;
    nex:articleId 42582 ;
    nex:classification "A" ;
    nex:description "We investigate the use of high-powered incentives for the Colombian military and show that this practice produced perverse side effects. Innocent civilians were killed and misrepresented as guerillas (a phenomenon known in Colombia as \"false positives\"). There were significantly more false positives during the period of high-powered incentives in municipalities with weaker judicial institutions and where a higher share of brigades were commanded by colonels, who have stronger career concerns than generals. In municipalities with a higher share of colonels, the high-powered incentives period also coincided with a worsening of local judicial institutions and no discernible improvement in overall security." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8207> ;
    nex:productType "article" ;
    nex:publicationYear 2020 ;
    nex:title "The perils of high-powered incentives: Evidence from Colombia's false positives" ;
    nex:url "http://doi.org/10.1257/POL.20180168"^^xsd:anyURI .

