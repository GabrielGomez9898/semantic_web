    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "Enabling Mechanisms for Circularity in Latin America and the Caribbean" ;
    nex:url "http://doi.org/10.55845/IKHI7118"^^xsd:anyURI .

