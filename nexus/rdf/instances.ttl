        <https://w3id.org/nexus/resource/professor/8833> ;
    nex:productType "article" ;
    nex:publicationYear 2023 ;
    nex:title "A multisensory mindfulness experience: exploring the promotion of sensory awareness as a mindfulness practice" ;
    nex:url "https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2023.1230832/full"^^xsd:anyURI .

