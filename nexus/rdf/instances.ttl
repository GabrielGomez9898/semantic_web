<https://w3id.org/nexus/resource/article/130731> a nex:JournalArticle ;
    nex:articleId 130731 ;
    nex:classification "C" ;
    nex:description "How do we move from rage to ritual? How do we become human? The work of René Girard would seem to offer an answer to this question. In this brief essay I want to simply add some evolutionary and neuroscientific details to Girard's theory, which flesh out while also corroborating the basic components of it." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/8967> ;
    nex:productType "article" ;
    nex:publicationYear 2024 ;
    nex:title "The neurology of culture, or how we move from rage to ritual in the process of hominization." ;
    nex:url "https://muse.jhu.edu/pub/26/article/933556/pdf"^^xsd:anyURI .

