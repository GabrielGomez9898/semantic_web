<https://w3id.org/nexus/resource/article/82198> a nex:JournalArticle ;
    nex:articleId 82198 ;
    nex:classification "A" ;
    nex:description "Given a representation of a compact Lie group and a state we define a probability measure on the coadjoint orbits of the dominant weights by considering the decomposition into irreducible components. For large tensor powers and independent copies of the state we show that the induced probability distributions converge to the value of the moment map. For faithful states we prove that the measures satisfy the large deviation principle with an explicitly given rate function." ;
    nex:hasAuthor <https://w3id.org/nexus/resource/professor/7481> ;
    nex:productType "article" ;
    nex:publicationYear 2021 ;
    nex:title "Large deviation principle for moment map estimation" ;
    nex:url "http://doi.org/10.1214/21-EJP636"^^xsd:anyURI .

