    nex:productType "article" ;
    nex:publicationYear 2021 ;
    nex:title "Have food supply chain policies improved forest conservation and rural livelihoods? A systematic review" ;
    nex:url "http://doi.org/10.1088/1748-9326/abe0ed"^^xsd:anyURI .

