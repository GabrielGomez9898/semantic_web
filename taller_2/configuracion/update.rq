# Sentencias para actualizar el primer grafo cargado
# con las clases de inferencia
#
# Ejecutar:  python correr.py configuracion/update.rq --update

DELETE {
  GRAPH <urn:ws2026:vocabulario> {
    ?s ?p ?o
  }
}
INSERT {
  ?s ?p ?o
}
WHERE {
  GRAPH <urn:ws2026:vocabulario> {
    ?s ?p ?o
  }
}