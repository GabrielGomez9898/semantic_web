PREFIX ex:   <http://example.org/uni/schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>


SELECT ?seccionDoctoral ?estudiante
WHERE {
    ?seccionDoctoral a ex:SeccionDoctoral .
    ?seccionDoctoral ex:tieneInscrito ?estudiante .
    ?estudiante a ex:EstudianteDoctorado .
}

