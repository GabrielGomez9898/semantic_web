bib:Premio a rdfs:Class ;
    rdfs:label "premio"@es ;
    rdfs:comment "Distinción otorgada a una persona."@es .

bib:Reconocimiento a rdfs:Class ;
    rdfs:label "reconocimiento"@es ;
    rdfs:comment "Hecho de que una persona recibió un premio, con su año cuando se conoce."@es .

